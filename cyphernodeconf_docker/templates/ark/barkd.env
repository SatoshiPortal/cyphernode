ARK_SERVER_URL=<%= ark_server_url %>
ARK_NETWORK=<%= net %>
BITCOIND_RPC_URL=http://<%= (bitcoin_mode === 'internal') ? 'bitcoin' : bitcoin_node_ip %>:<%= (net === 'regtest') ? '18443' : ((net === 'testnet') ? '18332' : ((net === 'signet') ? '38332' : '8332')) %>
BITCOIND_RPC_USER=<%= bitcoin_rpcuser %>
BITCOIND_RPC_PASS=<%= bitcoin_rpcpassword %>
BARKD_DATADIR=/barkd/data
BARKD_TOKEN_DIR=/barkd/token
BARKD_BIND_HOST=0.0.0.0
BARKD_BIND_PORT=3000
BARK_NO_LOGFILE=true
BARK_VTXO_REFRESH_EXPIRY_THRESHOLD=<%= (net === 'mainnet') ? '144' : '12' %>
BARKD_WAIT_FOR_BITCOIN=<%= (bitcoin_mode === 'internal') ? 'true' : 'false' %>
