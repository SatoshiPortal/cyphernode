-- Ark (barkd) tables. Applied to new installs from cyphernode.postgresql and
-- to existing installs by sqlmigrate20261103_0.9.0-0.9.0_ark.sh.

CREATE TABLE IF NOT EXISTS ark_watching (
  id SERIAL PRIMARY KEY,
  address VARCHAR NOT NULL,
  label VARCHAR,
  watching BOOLEAN DEFAULT FALSE,
  callback_url VARCHAR,
  event_message VARCHAR,
  expected_amount_sat BIGINT,
  inserted_ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_ark_watching_address ON ark_watching (address);
CREATE INDEX IF NOT EXISTS idx_ark_watching_label ON ark_watching (label);
CREATE INDEX IF NOT EXISTS idx_ark_watching_watching ON ark_watching (watching);
CREATE UNIQUE INDEX IF NOT EXISTS idx_ark_watching_address_cb ON ark_watching (address, COALESCE(callback_url, ''));

CREATE TABLE IF NOT EXISTS ark_receive (
  id SERIAL PRIMARY KEY,
  movement_id INTEGER NOT NULL,
  ark_watching_id INTEGER REFERENCES ark_watching,
  address VARCHAR NOT NULL,
  amount_sat BIGINT NOT NULL,
  vtxos VARCHAR,
  calledback BOOLEAN DEFAULT FALSE,
  calledback_ts TIMESTAMP,
  callback_failures INTEGER DEFAULT 0,
  inserted_ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_ark_receive_movement_watch ON ark_receive (movement_id, ark_watching_id);
CREATE INDEX IF NOT EXISTS idx_ark_receive_calledback ON ark_receive (calledback);

CREATE TABLE IF NOT EXISTS ark_job (
  id SERIAL PRIMARY KEY,
  kind VARCHAR NOT NULL,
  label VARCHAR NOT NULL UNIQUE,
  callback_url VARCHAR,
  txid VARCHAR,
  vtxos VARCHAR,
  movement_id INTEGER,
  status VARCHAR NOT NULL,
  error VARCHAR,
  calledback BOOLEAN DEFAULT FALSE,
  calledback_ts TIMESTAMP,
  callback_failures INTEGER DEFAULT 0,
  inserted_ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_ark_job_status ON ark_job (status);
CREATE INDEX IF NOT EXISTS idx_ark_job_movement ON ark_job (movement_id);

CREATE TABLE IF NOT EXISTS ark_ln_invoice (
  id SERIAL PRIMARY KEY,
  label VARCHAR NOT NULL UNIQUE,
  bolt11 VARCHAR,
  payment_hash VARCHAR,
  amount_sat BIGINT NOT NULL,
  description VARCHAR,
  expires_at BIGINT,
  callback_url VARCHAR,
  event_message VARCHAR,
  status VARCHAR NOT NULL,
  movement_id INTEGER,
  received_sat BIGINT,
  fee_sat BIGINT,
  calledback BOOLEAN DEFAULT FALSE,
  calledback_ts TIMESTAMP,
  callback_failures INTEGER DEFAULT 0,
  inserted_ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_ark_ln_invoice_payment_hash ON ark_ln_invoice (payment_hash);
CREATE INDEX IF NOT EXISTS idx_ark_ln_invoice_status ON ark_ln_invoice (status);
CREATE INDEX IF NOT EXISTS idx_ark_ln_invoice_calledback ON ark_ln_invoice (calledback);

CREATE TABLE IF NOT EXISTS ark_ln_send (
  id SERIAL PRIMARY KEY,
  payment_hash VARCHAR NOT NULL UNIQUE,
  event_message VARCHAR,
  movement_id INTEGER,
  status VARCHAR NOT NULL,
  published BOOLEAN DEFAULT FALSE,
  inserted_ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO cyphernode_props (property, value, category)
SELECT 'ark_last_pushed_at', '', 'ark'
WHERE NOT EXISTS (SELECT 1 FROM cyphernode_props WHERE property = 'ark_last_pushed_at');
INSERT INTO cyphernode_props (property, value, category)
SELECT 'ark_history_floor', '0', 'ark'
WHERE NOT EXISTS (SELECT 1 FROM cyphernode_props WHERE property = 'ark_history_floor');
